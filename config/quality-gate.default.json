{
  "version": "1.0.0",
  "policy": {
    "mode": "permissive",
    "failOnBuildError": false,
    "failOnMissingEvidence": false,
    "minCompletenessPct": 0,
    "minConfidence": "Low"
  },
  "artifacts": {
    "root": "artifacts",
    "layout": {
      "rawTestResults": "raw/test-results",
      "rawCoverage": "raw/coverage",
      "rawSarif": "raw/sarif",
      "status": "status",
      "validation": "validation"
    }
  },
  "tolerances": {
    "testCounts": 0,
    "coveragePct": 0.5,
    "branchCoveragePct": 0.5,
    "sarifCounts": 0
  },
  "scoring": {
    "weights": {
      "staticQualityWeight": 0.35,
      "testWeight": 0.30,
      "coverageWeight": 0.25,
      "securityWeight": 0.10,
      "staticErrorPenaltyPerItem": 8
    },
    "thresholds": {
      "goMin": 85,
      "conditionalGoMin": 70
    }
  },
  "coverage": {
    "format": "cobertura",
    "pathPatterns": [
      "**/coverage.xml",
      "**/cobertura.xml",
      "**/coverage/**.xml",
      "**/coverage.cobertura.xml"
    ]
  },
  "trx": {
    "pathPatterns": [
      "**/*.trx",
      "**/TEST-*.xml",
      "**/junit*.xml"
    ]
  },
  "sarif": {
    "pathPatterns": [
      "**/*.sarif"
    ]
  },
  "stacks": {
    "dotnet": {
      "requiredTools": ["dotnet"],
      "setupCommands": [],
      "buildCommands": [
        "dotnet build {targetPath} --configuration {configuration} --no-incremental"
      ],
      "testCommands": [
        "dotnet test {testProjectPath} --configuration {configuration} --results-directory {rawTestResults} --logger \"trx;LogFileName={testProjectName}.trx\" --collect \"XPlat Code Coverage\" --settings {repoRoot}\\coverlet.runsettings"
      ],
      "analysisCommands": []
    },
    "node": {
      "requiredTools": ["node", "npm"],
      "setupCommands": ["npm ci"],
      "buildCommands": ["npm run build --if-present"],
      "testCommands": [
        "npm test -- --reporter junit --outputFile {rawTestResults}\\junit.xml"
      ],
      "analysisCommands": []
    },
    "python": {
      "requiredTools": ["python"],
      "setupCommands": [
        "python -m pip install --upgrade pip",
        "pip install -r requirements.txt"
      ],
      "buildCommands": [],
      "testCommands": [
        "python -m pytest --junitxml={rawTestResults}\\junit.xml --cov=. --cov-report=xml:{rawCoverage}\\coverage.xml"
      ],
      "analysisCommands": []
    },
    "java": {
      "requiredTools": [],
      "setupCommands": [],
      "buildCommands": [],
      "testCommands": [],
      "analysisCommands": []
    },
    "go": {
      "requiredTools": ["go"],
      "setupCommands": [],
      "buildCommands": ["go build ./..."],
      "testCommands": [
        "go test ./... -v -coverprofile={rawCoverage}\\coverage.out"
      ],
      "analysisCommands": []
    },
    "rust": {
      "requiredTools": ["cargo"],
      "setupCommands": [],
      "buildCommands": ["cargo build --release"],
      "testCommands": ["cargo test"],
      "analysisCommands": []
    },
    "unknown": {
      "requiredTools": [],
      "setupCommands": [],
      "buildCommands": [],
      "testCommands": [],
      "analysisCommands": []
    }
  }
}
